# Database — Postgres connection string (e.g. from Neon: https://console.neon.tech)
# Neon example: postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/novira

# Application URL
ORIGIN=http://localhost:5173

# Set to "true" to pre-fill demo credentials on the login page
# DEMO_MODE=true

# pLitter detection API (FastAPI, see /pLitter/api_server.py) — base URL for
# the twice-daily Bandung CCTV detection cron (src/lib/server/novira/deteksi.ts)
PLITTER_API_URL=http://localhost:8000

# Vercel Blob — stores uploaded/captured photos & videos (src/lib/server/uploads.ts).
# Required even though this app doesn't run on Vercel's serverless platform;
# Blob is used purely as file storage over HTTP. Create a Blob store at
# https://vercel.com/dashboard (any project) → Storage → Blob, then copy its
# "Read/Write Token" here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
